// This is your database configuration
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma-client"
}

// User Table: For both Riders and Drivers
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String
  password String?
  googleId String? @unique
  avatar   String?
  role     Role    @default(RIDER)

  // For Ride-Hailing logic
  phone  String?
  rating Float   @default(5.0)

  // Relational fields (for later)
  ridesAsRider  Ride[] @relation("RiderRides")
  ridesAsDriver Ride[] @relation("DriverRides")

  createdAt DateTime @default(now())
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum RideStatus {
  PENDING
  ACCEPTED
  ONGOING
  COMPLETED
  CANCELLED
}

enum VehicleType {
  BoltBike
  BoltMini
  BoltMinini
  BoltSedan
  BoltSedan2
  BoltSuite
}

model Ride {
  id         String     @id @default(uuid())
  riderId    String
  driverId   String?
  status     RideStatus @default(PENDING) // PENDING, ACCEPTED, COMPLETED
  pickupLoc  String // We can use Geometry types later for PostGIS
  dropoffLoc String

  vehicleType String // BoltBike, BoltSedan, BoltMini, etc.
  fare        Float // Keeps currency/cost floating-point accurate 
  distanceKm  Float? // Useful to save for receipts/history summaries
  durationMin Float? // Useful to save for receipts/history summaries

  createdAt DateTime @default(now()) // Keeps order chronological

  rider  User  @relation("RiderRides", fields: [riderId], references: [id])
  driver User? @relation("DriverRides", fields: [driverId], references: [id])
}
